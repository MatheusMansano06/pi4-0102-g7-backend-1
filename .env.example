# Copie este arquivo para .env antes de subir o projeto:
#   cp .env.example .env
# O .env nao vai para o git, entao cada um pode ajustar o seu.

# Banco de dados
POSTGRES_DB=archflow
POSTGRES_USER=archflow
POSTGRES_PASSWORD=archflow123

# Portas usadas na sua maquina
PORTA_BANCO=5432
PORTA_BACKEND=8080
PORTA_FRONTEND=5173

# Senha secreta com que o backend assina o token do login.
# Precisa de pelo menos 32 caracteres. Troque a sua.
ARCHFLOW_TOKEN_SEGREDO=troque-este-segredo-de-desenvolvimento-do-archflow
