# Copie este arquivo para .env antes de subir o projeto:
#   cp .env.example .env
# O .env nao vai para o git, entao cada um pode ajustar o seu.

# Banco de dados
POSTGRES_DB=archflow
POSTGRES_USER=archflow
POSTGRES_PASSWORD=archflow123

# Portas usadas na sua maquina
PORTA_BANCO=5432
PORTA_BACKEND=8080
PORTA_FRONTEND=5173
PORTA_KEYCLOAK=8081

# Conta de administrador do Keycloak (so para abrir o painel em
# http://localhost:8081 e cadastrar as pessoas do grupo).
KEYCLOAK_ADMIN_USUARIO=admin
KEYCLOAK_ADMIN_SENHA=admin
